# =======================================================
# MENTORVERSE ENVIRONMENT CONFIGURATION
# =======================================================

# Supabase (Required for Admin Dashboard to read live stats, users, sessions, and submissions)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AI Inference LLM Configuration (Multi-Provider: Groq, OpenAI, Gemini, Hugging Face, or built-in free cloud AI)
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
NEXT_PUBLIC_HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
HUGGINGFACE_API_KEY=your_huggingface_api_key
HF_TOKEN=your_huggingface_api_key

# Firebase Client Configuration (Learner Auth)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin Configuration (Optional for backend verification)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_PRIVATE_KEY=your_private_key

# Admin Dashboard Credentials (Optional - Defaults to Admin / PROJECT@TRUE if omitted)
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=PROJECT@TRUE
